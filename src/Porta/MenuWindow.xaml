<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Porta.MenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Porta.Models"
    Title="Porta">

    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.Resources>
          <ResourceDictionary>
            <!-- Panel colours from design/Main.dc.html -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Right pane: a slightly lighter frosted tint than the left, with a soft border of its own -->
                    <SolidColorBrush x:Key="PortaRailBrush" Color="#FFFFFF" Opacity="0.09" />
                    <SolidColorBrush x:Key="PortaRailBorderBrush" Color="#FFFFFF" Opacity="0.13" />
                    <SolidColorBrush x:Key="PortaHairlineBrush" Color="#FFFFFF" Opacity="0.10" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PortaRailBrush" Color="#FFFFFF" Opacity="0.35" />
                    <SolidColorBrush x:Key="PortaRailBorderBrush" Color="#0F1428" Opacity="0.10" />
                    <SolidColorBrush x:Key="PortaHairlineBrush" Color="#0F1428" Opacity="0.10" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Flat buttons for the right-hand panel -->
            <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Height" Value="34" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="RailIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <!-- One row in All apps and in search results -->
            <DataTemplate x:Key="AppRowTemplate" x:DataType="m:AppEntry">
                <Grid ColumnSpacing="12" Height="40" Background="Transparent" RightTapped="Item_RightTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28">
                        <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind InitialVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Initial}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>

            <!-- One Wikipedia article in search -->
            <DataTemplate x:Key="WikiRowTemplate" x:DataType="m:WikiEntry">
                <Grid ColumnSpacing="12" Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Letter tile until (and unless) the article's picture arrives; the picture fills the box, centre-cropped -->
                    <Grid Width="40" Height="40">
                        <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{x:Bind InitialVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="6" Visibility="{x:Bind IconVisibility, Mode=OneWay}">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="Open" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
            </DataTemplate>

            <!-- The quick answer (top of search) and the "Search the web" row (bottom) -->
            <DataTemplate x:Key="QuickRowTemplate" x:DataType="m:QuickRow">
                <Grid ColumnSpacing="12" Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ActionText}" Visibility="{x:Bind ActionVisibility}" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
            </DataTemplate>

            <!-- One recent file or folder in search: Open (click the row) and Show in folder -->
            <DataTemplate x:Key="PathRowTemplate" x:DataType="m:PathEntry">
                <Grid ColumnSpacing="12" Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                        <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind InitialVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind FullPath}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Open" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Grid>
                            <HyperlinkButton Content="Show in folder" FontSize="12" Padding="6,2" Click="ShowInFolder_Click" />
                            <Border CornerRadius="4" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    IsHitTestVisible="False" Visibility="{x:Bind SecondaryVisibility, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- One person from Ocula in search -->
            <DataTemplate x:Key="PersonRowTemplate" x:DataType="m:PersonEntry">
                <Grid ColumnSpacing="12" Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <TextBlock Text="{x:Bind Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{x:Bind InitialVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ActionText}" Visibility="{x:Bind ActionVisibility}" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
            </DataTemplate>

            <!-- One Windows tool, Settings page or power action in search -->
            <DataTemplate x:Key="SystemRowTemplate" x:DataType="m:SystemEntry">
                <Grid ColumnSpacing="12" Height="44" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- One game in search: installed games and Steam store results -->
            <DataTemplate x:Key="GameRowTemplate" x:DataType="m:GameEntry">
                <Grid ColumnSpacing="12" Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Wide cover: fills the box (centre-cropped, rounded corners), nothing behind it while it loads -->
                    <Border Width="92" Height="43" CornerRadius="6" Visibility="{x:Bind WideArtVisibility, Mode=OneWay}">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                        </Border.Background>
                    </Border>
                    <!-- Wikipedia picture (Battle.net games): fills the box, cropped evenly from the sides and cropped a little above
                         the centre (see PictureShiftY) so faces near the top aren't cut off. Nothing is drawn behind it, and it is just as clear while it loads. -->
                    <Border Width="92" Height="43" CornerRadius="6" Visibility="{x:Bind PictureArtVisibility, Mode=OneWay}">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top">
                                <ImageBrush.RelativeTransform>
                                    <TranslateTransform Y="{x:Bind PictureShiftY, Mode=OneWay}" />
                                </ImageBrush.RelativeTransform>
                            </ImageBrush>
                        </Border.Background>
                    </Border>
                    <!-- No cover and no picture: the game's small icon, or the letter, on the usual tile -->
                    <Border Width="92" Height="43" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind IconTileVisibility, Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="{x:Bind Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{x:Bind InitialVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Image Source="{x:Bind Badge.Icon, Mode=OneWay, FallbackValue={x:Null}}" Width="13" Height="13" VerticalAlignment="Center"
                                   Visibility="{x:Bind Badge.IconVisibility, Mode=OneWay, FallbackValue=Collapsed}" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ActionText}" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
            </DataTemplate>
          </ResourceDictionary>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="216" />
        </Grid.ColumnDefinitions>
        <!-- Row 0 is the strip above the panel where the account picture breaks out; the window is
             cut to the panel plus the picture's circle, so the rest of that strip isn't drawn. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Left: search, pinned, all apps ===== -->
        <Grid Grid.Row="1" Padding="24,24,20,16" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Pill search bar: fully rounded, darker filled, thin neutral border, soft placeholder, magnifier on the left;
                 the periwinkle ring shows only while it has focus (instead of WinUI's underline, which looks odd on a pill). -->
            <Grid>
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search apps, files and settings"
                         AutomationProperties.Name="Search"
                         Height="40" CornerRadius="20" Padding="40,9,8,0"
                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" InputScope="SearchIncremental"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="TextControlBackground" Color="#000000" Opacity="0.38" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#000000" Opacity="0.42" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#000000" Opacity="0.50" />
                                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#FFFFFF" Opacity="0.16" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFFFFF" Opacity="0.16" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FFFFFF" Opacity="0.24" />
                                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#8AA8FF" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8AA8FF" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FFFFFF" Opacity="0.55" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FFFFFF" Opacity="0.60" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FFFFFF" Opacity="0.45" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="TextControlBackground" Color="#0F1428" Opacity="0.10" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0F1428" Opacity="0.13" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" Opacity="0.75" />
                                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#0F1428" Opacity="0.16" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#0F1428" Opacity="0.16" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#0F1428" Opacity="0.24" />
                                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#5F7EE0" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5F7EE0" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#0F1428" Opacity="0.55" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#0F1428" Opacity="0.60" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#0F1428" Opacity="0.45" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <!-- Same 1 px all round when focused: a ring, not a thicker bottom line -->
                            <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                        </ResourceDictionary>
                    </TextBox.Resources>
                </TextBox>
                <FontIcon Glyph="&#xE721;" FontSize="14" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
            </Grid>

            <!-- "Pinned" and an "All apps ›" chip on its right; in All apps the heading changes and the chip becomes "‹ Back" -->
            <Grid x:Name="ViewHeader" Grid.Row="1" Height="32" Margin="4,0,0,0">
                <TextBlock x:Name="ViewTitle" Text="Pinned" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="ViewToggleButton" Content="All apps  ›" HorizontalAlignment="Right" VerticalAlignment="Center"
                        FontSize="12" Padding="10,4" CornerRadius="6" Click="ViewToggle_Click"
                        AutomationProperties.Name="All apps" />
            </Grid>

            <Grid Grid.Row="2">
                <!-- Pinned + Recent -->
                <Grid x:Name="PinnedPanel" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GridView x:Name="PinnedGrid" HorizontalAlignment="Center"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="App_ItemClick"
                              CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              DragItemsStarting="PinnedGrid_DragItemsStarting" DragItemsCompleted="PinnedGrid_DragItemsCompleted">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="86" ItemHeight="82" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="m:AppEntry">
                                <StackPanel Width="82" Spacing="4" VerticalAlignment="Top" Background="Transparent"
                                            RightTapped="Item_RightTapped" ToolTipService.ToolTip="{x:Bind Name}">
                                    <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                        <Border CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind InitialVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="32" Height="32" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" HorizontalAlignment="Center" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <TextBlock x:Name="RecentHeader" Grid.Row="1" Text="Recent" FontWeight="SemiBold" Margin="4,2,0,0" />

                    <ListView x:Name="RecentList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Recent_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:RecentItem">
                                <Grid ColumnSpacing="12" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind When}" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- All apps, grouped A–Z -->
                <!-- Letter jump: click a letter heading (A, B, ...) to see all the letters, then click one to jump to it -->
                <SemanticZoom x:Name="AllAppsZoom" Visibility="Collapsed" IsZoomOutButtonEnabled="False">
                    <SemanticZoom.ZoomedInView>
                        <ListView x:Name="AllAppsList"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="App_ItemClick"
                                  ItemTemplate="{StaticResource AppRowTemplate}">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate x:DataType="m:AppGroup">
                                            <TextBlock Text="{x:Bind Key}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       ToolTipService.ToolTip="Jump to a letter" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                        </ListView>
                    </SemanticZoom.ZoomedInView>
                    <SemanticZoom.ZoomedOutView>
                        <GridView x:Name="AllAppsLetters" SelectionMode="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="52" Height="52" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding Group.Key}" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </SemanticZoom.ZoomedOutView>
                </SemanticZoom>

                <!-- Search results -->
                <Grid x:Name="SearchPanel" Visibility="Collapsed" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Installed games, then apps, then store results, each directly below the last; scrolls as one -->
                    <ScrollViewer x:Name="ResultsScroller" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6" Margin="0,0,14,0" PointerMoved="Results_PointerMoved">
                            <StackPanel.Resources>
                                <!-- Keyboard and mouse share one highlight (the selected row, in the accent colour). The plain
                                     hover and press shades are off here so the highlight never shows on two rows at once;
                                     hovering a row selects it instead (Results_PointerMoved). -->
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.30" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.30" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.40" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                            </StackPanel.Resources>
                            <!-- A calculation or conversion: one row, always on top ("Quick answers" turns it off) -->
                            <ListView x:Name="QuickList" Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Quick_ItemClick"
                                      ItemTemplate="{StaticResource QuickRowTemplate}"
                                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                            <!-- Games from Steam, Epic, Battle.net and Xbox -->
                            <StackPanel x:Name="GamesSection" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="Games" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView x:Name="GamesList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Game_ItemClick"
                                          ItemTemplate="{StaticResource GameRowTemplate}"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>

                            <ListView x:Name="ResultsList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="App_ItemClick"
                                      ItemTemplate="{StaticResource AppRowTemplate}"
                                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                            <!-- Windows tools, Settings pages and power actions: below Apps -->
                            <StackPanel x:Name="SystemSection" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="System and settings" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView x:Name="SystemList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="System_ItemClick"
                                          ItemTemplate="{StaticResource SystemRowTemplate}"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>

                            <!-- Recent files and folders (off until "Search recent files and folders" is on): below apps, games and tools -->
                            <StackPanel x:Name="PathsSection" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="Recent files and folders" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView x:Name="PathsList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Path_ItemClick"
                                          ItemTemplate="{StaticResource PathRowTemplate}"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>

                            <!-- People named in Ocula (off until "Search people in Ocula" is on): below apps, games and tools -->
                            <StackPanel x:Name="PeopleSection" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="People in Ocula" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView x:Name="PeopleList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Person_ItemClick"
                                          ItemTemplate="{StaticResource PersonRowTemplate}"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>

                            <!-- Games from the Steam store that aren't installed: always below installed apps and games -->
                            <StackPanel x:Name="StoreSection" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="From the Steam store" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView x:Name="StoreList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Game_ItemClick"
                                          ItemTemplate="{StaticResource GameRowTemplate}"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>

                            <!-- Battle.net games from Assets\battlenet-games.json: below Steam store rows, above Wikipedia -->
                            <StackPanel x:Name="BattleNetSection" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="Battle.net games" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView x:Name="BattleNetList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Game_ItemClick"
                                          ItemTemplate="{StaticResource GameRowTemplate}"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>

                            <!-- Wikipedia articles (online; "Search Wikipedia" turns it off) -->
                            <StackPanel x:Name="WikiSection" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="From Wikipedia" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView x:Name="WikiList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Wiki_ItemClick"
                                          ItemTemplate="{StaticResource WikiRowTemplate}"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>

                            <!-- Always the last row: opens the browser on your search engine. Nothing is sent until it is used. -->
                            <ListView x:Name="WebList" Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Web_ItemClick"
                                      ItemTemplate="{StaticResource QuickRowTemplate}"
                                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="NoResultsText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <!-- Search a game store for what was typed -->
                    <StackPanel x:Name="StoreLinks" Grid.Row="1" Orientation="Horizontal" Spacing="0" Visibility="Collapsed">
                        <TextBlock Text="Search stores:" FontSize="12" VerticalAlignment="Center" Margin="4,0,2,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton x:Name="SteamStoreLink" Content="Steam" FontSize="12" Padding="7,4" Click="StoreLink_Click" Tag="steam" />
                        <HyperlinkButton x:Name="EpicStoreLink" Content="Epic Games" FontSize="12" Padding="7,4" Click="StoreLink_Click" Tag="epic" />
                        <HyperlinkButton x:Name="BattleNetStoreLink" Content="Battle.net" FontSize="12" Padding="7,4" Click="StoreLink_Click" Tag="battlenet" />
                        <HyperlinkButton x:Name="MsStoreLink" Content="Microsoft Store" FontSize="12" Padding="7,4" Click="StoreLink_Click" Tag="xbox" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Right: account, places, power ===== -->
        <Border Grid.Row="1" Grid.Column="1" CornerRadius="0,8,8,0"
                Background="{ThemeResource PortaRailBrush}"
                BorderThickness="1,0,0,0" BorderBrush="{ThemeResource PortaRailBorderBrush}">
        <Grid Padding="10,42,10,12" RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The picture itself sits on the panel's top edge (below); the name goes under it. -->
            <TextBlock x:Name="UserNameText" Margin="0,0,0,14" FontSize="20" FontWeight="SemiLight"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Row="1" Spacing="0">
                <Button Style="{StaticResource RailButton}" Tag="shell:Personal" Click="Folder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8A5;" FontSize="14" /><TextBlock Text="Documents" /></StackPanel>
                </Button>
                <Button Style="{StaticResource RailButton}" Tag="shell:Downloads" Click="Folder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE896;" FontSize="14" /><TextBlock Text="Downloads" /></StackPanel>
                </Button>
                <Button Style="{StaticResource RailButton}" Tag="shell:My Music" Click="Folder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8D6;" FontSize="14" /><TextBlock Text="Music" /></StackPanel>
                </Button>
                <Button Style="{StaticResource RailButton}" Tag="shell:My Pictures" Click="Folder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B9;" FontSize="14" /><TextBlock Text="Pictures" /></StackPanel>
                </Button>
                <!-- The user's own folder ("Show user folder link" turns it off) -->
                <Button x:Name="UserFolderRow" Style="{StaticResource RailButton}" Tag="shell:UsersFilesFolder" Click="Folder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE77B;" FontSize="14" /><TextBlock x:Name="UserFolderText" Text="Your folder" TextTrimming="CharacterEllipsis" MaxWidth="130" /></StackPanel>
                </Button>
                <Button Style="{StaticResource RailButton}" Tag="shell:MyComputerFolder" Click="Folder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE977;" FontSize="14" /><TextBlock Text="PC" /></StackPanel>
                </Button>
                <!-- "Show Control Panel" turns it off -->
                <Button x:Name="ControlPanelRow" Style="{StaticResource RailButton}" Click="ControlPanel_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE9E9;" FontSize="14" /><TextBlock Text="Control Panel" /></StackPanel>
                </Button>
                <Button Style="{StaticResource RailButton}" Click="WindowsSettings_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="14" /><TextBlock Text="Settings" /></StackPanel>
                </Button>
                <Button Style="{StaticResource RailButton}" Click="Run_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE756;" FontSize="14" /><TextBlock Text="Run…" /></StackPanel>
                </Button>
            </StackPanel>

            <!-- Clock and date ("Show clock card" turns it on) -->
            <Border x:Name="ClockCard" Grid.Row="3" Visibility="Collapsed" CornerRadius="12" Padding="14,12" Margin="0,0,0,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="ClockText" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="DateText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Bottom: Porta's settings (small and quiet), then the power button in the middle ("Show lock button" adds a lock button beside it) -->
            <Grid Grid.Row="4" Margin="0,6,0,0" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Glass strength and Porta's switches (moves to Settings when that window exists) -->
                <Button Style="{StaticResource RailIconButton}" Width="32" Height="32" Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Center"
                        AutomationProperties.Name="Porta settings" ToolTipService.ToolTip="Porta settings">
                    <FontIcon Glyph="&#xE790;" FontSize="14" />
                    <Button.Flyout>
                        <Flyout x:Name="PaletteFlyout" Placement="Top" Closed="GlassFlyout_Closed">
                            <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                            <StackPanel Width="220" Spacing="4">
                                <TextBlock Text="Glass strength" FontSize="13" FontWeight="SemiBold" />
                                <Slider x:Name="GlassSlider" Minimum="0" Maximum="100" StepFrequency="5"
                                        AutomationProperties.Name="Glass strength" ValueChanged="GlassSlider_ValueChanged" />
                                <Grid>
                                    <TextBlock Text="Clear" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Frosted" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <!-- Until the Settings window exists (milestone 2) -->
                                <ToggleSwitch x:Name="CloseElsewhereToggle" Header="Close when I click elsewhere" Margin="0,8,0,0"
                                              Toggled="CloseElsewhereToggle_Toggled" />
                                <ToggleSwitch x:Name="StartButtonToggle" Header="Open Porta from the Start button"
                                              Toggled="StartButtonToggle_Toggled" />
                                <ToggleSwitch x:Name="ShowRecentToggle" Header="Show recent items"
                                              Toggled="ShowRecentToggle_Toggled" />
                                <ToggleSwitch x:Name="ShowUserFolderToggle" Header="Show my folder link"
                                              Toggled="ShowUserFolderToggle_Toggled" />
                                <ToggleSwitch x:Name="ShowControlPanelToggle" Header="Show Control Panel"
                                              Toggled="ShowControlPanelToggle_Toggled" />
                                <ToggleSwitch x:Name="ShowClockToggle" Header="Show clock card"
                                              Toggled="ShowClockToggle_Toggled" />
                                <ToggleSwitch x:Name="ShowLockToggle" Header="Show lock button"
                                              Toggled="ShowLockToggle_Toggled" />
                                <ToggleSwitch x:Name="WikipediaToggle" Header="Search Wikipedia"
                                              Toggled="WikipediaToggle_Toggled" />
                                <ToggleSwitch x:Name="WikipediaPicturesToggle" Header="Wikipedia pictures"
                                              Toggled="WikipediaPicturesToggle_Toggled" />
                                <ToggleSwitch x:Name="EpicLibraryToggle" Header="Epic library"
                                              Toggled="EpicLibraryToggle_Toggled" />
                                <ToggleSwitch x:Name="EpicCoversToggle" Header="Epic cover images"
                                              Toggled="EpicCoversToggle_Toggled" />
                                <ToggleSwitch x:Name="BattleNetGamesToggle" Header="Search Battle.net games"
                                              Toggled="BattleNetGamesToggle_Toggled" />
                                <ToggleSwitch x:Name="RecentFilesToggle" Header="Search recent files and folders"
                                              Toggled="RecentFilesToggle_Toggled" />
                                <HyperlinkButton x:Name="ExcludeFoldersButton" Content="Exclude folders…" Margin="0,-4,0,4" Click="ExcludeFolders_Click" />
                                <ToggleSwitch x:Name="OculaPeopleToggle" Header="Search people in Ocula"
                                              Toggled="OculaPeopleToggle_Toggled" />
                                <ToggleSwitch x:Name="QuickAnswersToggle" Header="Quick answers"
                                              Toggled="QuickAnswersToggle_Toggled" />
                                <ToggleSwitch x:Name="CurrencyRatesToggle" Header="Online currency rates"
                                              Toggled="CurrencyRatesToggle_Toggled" />
                                <ToggleSwitch x:Name="WebSearchToggle" Header="Search the web"
                                              Toggled="WebSearchToggle_Toggled" />
                                <ComboBox x:Name="WebEngineBox" Header="Web search engine" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                          SelectionChanged="WebEngineBox_SelectionChanged">
                                    <ComboBoxItem Content="Google" />
                                    <ComboBoxItem Content="DuckDuckGo" />
                                    <ComboBoxItem Content="Bing" />
                                </ComboBox>
                                <TextBlock Text="Nothing is sent until you click the Search the web row (or press Enter with nothing else to open). Then Google, or the engine you pick here, receives your search words."
                                           FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="LockButton" Style="{StaticResource RailIconButton}" Click="Lock_Click" Visibility="Collapsed"
                            AutomationProperties.Name="Lock" ToolTipService.ToolTip="Lock">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource RailIconButton}"
                            AutomationProperties.Name="Power options" ToolTipService.ToolTip="Power">
                        <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem Text="Lock" Click="Lock_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Sleep" Click="Sleep_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE708;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Sign out" Click="SignOut_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE748;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Restart" Click="Restart_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Shut down" Click="ShutDown_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        </Border>

        <!-- The one hairline around the visible panel (Windows' own border is off: it would outline the whole
             window rectangle, not the cut shape). Drawn after both panes so nothing covers it. The top edge
             is two pieces that stop 4 px short of the picture's ring, so the edge looks cut out around it:
             the circle's centre is the middle of the 216 px right column, its ring 32 px in radius, so each
             piece ends 32 + 4 = 36 px from the centre, i.e. 72 px into the column from either side. -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,144,0" Height="8" VerticalAlignment="Top"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" BorderBrush="{ThemeResource PortaHairlineBrush}" IsHitTestVisible="False" />
        <Border Grid.Row="1" Grid.Column="1" Width="72" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                BorderThickness="0,1,1,0" CornerRadius="0,8,0,0" BorderBrush="{ThemeResource PortaHairlineBrush}" IsHitTestVisible="False" />
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" BorderBrush="{ThemeResource PortaHairlineBrush}" IsHitTestVisible="False" />

        <!-- Account picture, centred on the right pane's top edge (60 px with a thin ring = 64 px circle).
             Last in the file so it's drawn above both panes and the hairline: nothing crosses the photo. -->
        <Grid Grid.RowSpan="2" Grid.Column="1" Width="64" Height="64" Margin="0,0,0,0"
              HorizontalAlignment="Center" VerticalAlignment="Top">
            <Ellipse Fill="{ThemeResource PortaRailBrush}" Stroke="{ThemeResource PortaHairlineBrush}" StrokeThickness="2" />
            <PersonPicture x:Name="Avatar" Width="60" Height="60" />
        </Grid>
    </Grid>
</Window>
